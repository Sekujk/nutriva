{
  "expo": {
    "name": "Nutriva",
    "slug": "Nutriva",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#5c8d72",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "name": "Nutriva",
      "shortName": "Nutriva",
      "themeColor": "#5c8d72",
      "backgroundColor": "#5c8d72",
      "display": "standalone"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nutriva necesita acceso a tus fotos para que puedas elegir una foto de perfil."
        }
      ]
    ],
    "platforms": [
      "web"
    ]
  }
}
